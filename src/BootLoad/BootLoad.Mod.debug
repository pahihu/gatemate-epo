MODULE* BootLoad;
  (* NW 20.10.2013 / PR 4.2.2014 *)
  (* CFB 02.09.2015 Boot from SDHC disk only*)
  (* CFB 30.04.2018 Artix-7 XC7A35T, Spartan-7 XC7S50. 192KB BRAM: 160KB Code, 32KB Data *)
  (* CFB 06.08.2019 Up to SPI x 3, shift SPIFAST *)
  (* CFB 03.06.2020 512 KB RAM *)
  (* CFB 04.06.2020 SPIWORD option *)
  IMPORT SYSTEM;
  CONST MT = 12; SP = 14; LNK = 15;
    MTOrg = 20H; MemLim = 01C000H; stackOrg = 018000H;
    swi = -60; led = -60;
    spiData = -48; spiCtrl = -44; rsData = -56; rsCtrl = -52;
    time = -64;
    CARD0 = 1; SPIFAST = 8; SPIWORD = 16;
    FSoffset = 80000H;   (*block offset*)

	PROCEDURE Send(x: BYTE);
	BEGIN
	  REPEAT UNTIL SYSTEM.BIT(rsCtrl, 1);
	  SYSTEM.PUT(rsData, x)
	END Send;

	PROCEDURE Ln;
	BEGIN Send(0DH); Send(0AH)
	END Ln;

  PROCEDURE Led(x: INTEGER);
  	VAR b: INTEGER;
  BEGIN
  	b := x MOD 16;
  	IF b > 9 THEN INC(b, ORD("A") - ORD("0") - 10) END ;
  	Send(ORD("0") + b)
  END Led;

  PROCEDURE Hex(n: INTEGER);
  BEGIN Led(n DIV 16); Led(n MOD 16)
  END Hex;

  PROCEDURE Report(cmd, res: INTEGER);
  BEGIN Ln; Send(ORD("C")); Hex(cmd); Send(ORD("R")); Hex(res)
  END Report;

(* ---------- disk ------------*)

  PROCEDURE Receive(): INTEGER;
    VAR ret: INTEGER;
  BEGIN SYSTEM.PUT(spiData, 0FFH);
  	REPEAT UNTIL SYSTEM.BIT(spiCtrl, 0);
  	SYSTEM.GET(spiData, ret);
  	RETURN ret
  END Receive;

  PROCEDURE SPI(n: INTEGER); (*send&rcv byte slowly with card selected*)
  BEGIN SYSTEM.PUT(spiData, n);
    REPEAT UNTIL SYSTEM.BIT(spiCtrl, 0)
  END SPI;

  PROCEDURE SPIIdle(n: INTEGER); (*send n FFs slowly with no card selected*)
  BEGIN WHILE n > 0 DO DEC(n); SPI(-1) END
  END SPIIdle;

  PROCEDURE SPICmd(n, arg: INTEGER): INTEGER;
    VAR i, data, crc: INTEGER;
  BEGIN (*send cmd*)
  	REPEAT UNTIL Receive() = 0FFH;
    IF n = 8 THEN crc := 135 ELSIF n = 0 THEN crc := 149 ELSE crc := 255 END;
    SPI(n MOD 64 + 64); (*send command*)
    FOR i := 24 TO 0 BY -8 DO SPI(ROR(arg, i)) END; (*send arg*)
    SPI(crc); i := 32;
    REPEAT data := Receive(); DEC(i) UNTIL (data < 80H) OR (i = 0) ;
    RETURN data
  END SPICmd;

  PROCEDURE InitSPI;
  	CONST timeout = 10000;
    VAR res, data: INTEGER;
    		retries: INTEGER;
  BEGIN Send(ORD("S"));
  	Led(0);
  	SYSTEM.PUT(spiCtrl, 0);
  	SPIIdle(10); (*first, idle for at least 80 clks*)
  	SYSTEM.PUT(spiCtrl, CARD0 + SPIFAST);
    Led(1); res := SPICmd(0, 0); (*CMD0 when card selected, sets MMC SPI mode*)
    ASSERT(res = 1);
    Led(2); res := SPICmd(8, 1AAH); SPI(-1); SPI(-1); SPI(-1); (*CMD8 for SD cards*)
    retries := timeout;
    REPEAT (*until card becomes ready*)
      (*ACMD41, optionally with high-capacity (HCS) bit set, starts init*)
    	Led(3); res := SPICmd(55, 0); (*APP cmd follows*)
    	Led(4); res := SPICmd(41, LSL(1(*HCS*), 30));
      Report(41, res);
      Led(6); SPIIdle(10000);
      DEC(retries)
    UNTIL (res = 0) OR (retries = 0);
    ASSERT(res = 0)
  END InitSPI;

  PROCEDURE SDShift(VAR n: INTEGER);
    VAR data: INTEGER;
  BEGIN SPICmd(58, 0);  (*CMD58 get card capacity bit*)
    SYSTEM.GET(spiData, data); SPI(-1);
    IF (data # 0) OR ~SYSTEM.BIT(spiData, 6) THEN n := n * 512 END ;  (*non-SDHC card*)
    SPI(-1); SPI(-1); SPIIdle(1)  (*flush response*)
  END SDShift;

  PROCEDURE ReadSD(src, dst: INTEGER);
    VAR i, data: INTEGER;
  BEGIN
  	SYSTEM.PUT(spiCtrl, CARD0 + SPIFAST);
  	data := SPICmd(17, src); (*CMD17 read one block*)
    REPEAT UNTIL Receive() = 254;
    SYSTEM.PUT(spiCtrl, SPIWORD + SPIFAST + CARD0);
    FOR i := 0 TO 508 BY 4 DO
    	data := Receive();
			SYSTEM.PUT(dst, data); INC(dst, 4)
    END;
    SYSTEM.PUT(spiCtrl, SPIFAST + CARD0);
    data := Receive(); data := Receive(); (*may be a checksum; deselect card*)
    SYSTEM.PUT(spiCtrl, 0)
  END ReadSD;

  PROCEDURE LoadFromDisk;
    VAR src, dst, adr, lim: INTEGER;
  BEGIN src := FSoffset + 4;   (*start at boot block*)
    ReadSD(src, 0); SYSTEM.GET(16, lim);
    INC(src); dst := 512;
    WHILE dst < lim DO ReadSD(src, dst); INC(src); INC(dst, 512) END
  END LoadFromDisk;

BEGIN SYSTEM.LDREG(SP, stackOrg); SYSTEM.LDREG(MT, MTOrg);
  (*IF SYSTEM.REG(LNK) = 0 THEN (*cold start*)*)
    Led(80H); InitSPI;
    Led(82H); LoadFromDisk;
  (*END ;*)
  SYSTEM.PUT(12, MemLim); SYSTEM.PUT(24, stackOrg); Led(84H)
END BootLoad.
